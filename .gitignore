# Rust build output
target/
**/target/

# Runtime state written by the app. Tracked so a fresh clone has the demo cache
# and default preferences already in place; both are regenerated by the app.
# bharat-terminal/data/cache.db
# bharat-terminal/data/prefs.json
# bharat-terminal/crates/bt-data/data/
# *.db
# prefs.json

# egui / eframe persistence
*.ron

# Pinned native runtime (fetched by scripts/build-installer.ps1, ~16 MB).
# Tracked so a clone can run inference without a network fetch.
# bharat-terminal/native/*.dll

# WiX build artifacts (rebuilt by every MSI build)
*.wixpdb
*.wixobj

# Editor / OS
.vscode/
.idea/
Thumbs.db
desktop.ini
*.tmp
