# Rust build output
target/
**/target/

# Runtime state written by the app
bharat-terminal/data/cache.db
bharat-terminal/data/prefs.json
bharat-terminal/crates/bt-data/data/
*.db
prefs.json

# egui / eframe persistence
*.ron

# Pinned native runtime (fetched by scripts/build-installer.ps1, ~16 MB)
bharat-terminal/native/*.dll

# 100 MB GGUF, deliberately not shipped or loaded: on a 2 GB target the
# ONNX sessions plus a 135M instruct model spend the whole memory budget, and
# the commentary engine derives its text from measured outputs instead.
# Fetch locally if you want to experiment with it.
bharat-terminal/models/SmolLM2-*.gguf

# WiX build artifacts (rebuilt by every MSI build)
*.wixpdb
*.wixobj

# Editor / OS
.vscode/
.idea/
Thumbs.db
desktop.ini
*.tmp
