<!-- Bharat Terminal — Windows installer (WiX v5).
     Per-user install: no UAC prompt, lives under %LOCALAPPDATA%\Programs.
     Built with: wix build BharatTerminal.wxs -o <out>.msi
                 -ext WixToolset.UI.wixext -arch x64 -d AppVersion=3.0.0
     Made by Sourish Dey. -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package Name="Bharat Terminal"
           Version="$(var.AppVersion)"
           Manufacturer="Sourish Dey"
           UpgradeCode="13667D20-97CA-4E3D-82EB-678B9DAF3D3F"
           Language="1033"
           Codepage="1252"
           Scope="perUser"
           InstallerVersion="500"
           Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />

    <!-- Force per-user semantics explicitly. `Scope="perUser"` alone did not
         emit this in the built package (verified: no MSIINSTALLPERUSER row),
         so installs resolved per-machine. This property is the documented
         mechanism and keeps installs elevation-free with ARP under HKCU.
         ALLUSERS is cleared because a set ALLUSERS would override it. -->
    <Property Id="MSIINSTALLPERUSER" Value="1" />
    <!-- InstallLocation is not settable to a formatted path directly (a
         Property value may not reference another property), so resolve it
         after costing, before PublishProduct reads it. -->
    <SetProperty Id="ARPINSTALLLOCATION"
                 Value="[INSTALLFOLDER]"
                 After="CostFinalize"
                 Sequence="execute" />

    <MediaTemplate EmbedCab="yes" />

    <!-- Branded installer chrome. -->
    <ui:WixUI Id="WixUI_InstallDir" />
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
    <WixVariable Id="WixUILicenseRtf" Value="../assets/installer/license.rtf" />
    <WixVariable Id="WixUIDialogBmp" Value="../assets/installer/dialog.bmp" />
    <WixVariable Id="WixUIBannerBmp" Value="../assets/installer/banner.bmp" />

    <!-- Add/Remove Programs icon and info link. -->
    <Icon Id="appicon.ico" SourceFile="../assets/icons/app.ico" />
    <Property Id="ARPPRODUCTICON" Value="appicon.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/sourishdey2005/Bharat-terminal-exe" />

    <Feature Id="Main" Title="Bharat Terminal" Level="1">
      <ComponentRef Id="AppExe" />
      <ComponentRef Id="CliExe" />
      <ComponentRef Id="LicenseFile" />
      <ComponentRef Id="ReadmeFile" />
      <ComponentRef Id="ModelFiles" />
      <ComponentRef Id="SignalModelFiles" />
      <ComponentRef Id="PatchTstModelFiles" />
      <ComponentRef Id="PredictorScript" />
      <ComponentGroupRef Id="PythonRuntimeFiles" />
      <ComponentRef Id="NativeRuntime" />
      <ComponentRef Id="StartMenuShortcuts" />
    </Feature>

    <!-- One Component per file is generated by <Files>, so the group is what
         gives them a parent Feature. scripts/build-installer.ps1 stages this
         payload and then reads the MSI file table back to confirm the glob
         actually matched - an empty glob fails silently. -->
    <ComponentGroup Id="PythonRuntimeFiles" Directory="PythonRuntimeFolder">
      <Files Include="$(var.PayloadDir)\**" />
    </ComponentGroup>

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="BharatTerminal">
          <Component Id="AppExe" Guid="*">
            <File Id="BtAppExe" Source="../target/release/bt-app.exe" KeyPath="yes" />
          </Component>
            <Component Id="CliExe" Guid="*">
              <File Id="BtCliExe" Source="../target/release/bt-cli.exe" KeyPath="yes" />
            </Component>
            <!-- Pinned ONNX Runtime 1.28.0 (matches ort-sys). Lives next to
                 the executables so the loader finds it before any
                 incompatible system copy. Fetched by scripts/build-installer.ps1,
                 never committed. -->
            <Component Id="NativeRuntime" Guid="E7EB95B0-2355-49DA-B7E2-5111186B2CC4">
              <File Id="OnnxRuntime" Source="../native/onnxruntime.dll" KeyPath="yes" />
              <File Id="OnnxProvidersShared" Source="../native/onnxruntime_providers_shared.dll" />
            </Component>
          <Component Id="LicenseFile" Guid="*">
            <File Id="LicenseTxt" Source="../../LICENSE" Name="LICENSE.txt" KeyPath="yes" />
          </Component>
            <Component Id="ReadmeFile" Guid="*">
              <File Id="ReadmeMd" Source="../../README.md" KeyPath="yes" />
            </Component>
            <!-- Forecast model files. The Granite TTM weights are small (~1 MB)
                 and ship by default; only the ttm-rs CLI remains user-supplied.
                 The local ONNX forecasters ship too, because the Forecast tab
                 degrades to the statistical bench without them and Chronos is
                 the only genuinely pretrained model in the chain. The int8
                 Chronos graph is 9 MB rather than the 35 MB fp32 one, so the
                 installer stays small on a 2 GB machine. -->
            <Directory Id="ModelsFolder" Name="models">
                <Component Id="ModelFiles" Guid="A46E760F-AD4E-4FE6-A2E8-64AB8B0553CD">
                  <File Id="TtmGguf" Source="../models/ttm-q8.gguf" KeyPath="yes" />
                  <File Id="TtmConfig" Source="../models/config.json" />
                  <File Id="DLinearOnnx" Source="../models/dlinear.onnx" />
                  <File Id="NHitsOnnx" Source="../models/nhits_small.onnx" />
                  <File Id="ChronosInt8Onnx" Source="../models/chronos_bolt_tiny_int8.onnx" />
                  <File Id="ForecastModelsJson" Source="../models/forecast_models.json" />
                </Component>
                <!-- The BUY/HOLD/SELL classifier. It was referenced by the
                     Forecast tab but never packaged, so an installed app always
                     reported it missing. -->
                <Component Id="SignalModelFiles" Guid="7C1D4B92-58E6-4A3F-9D0C-2B6E85F41A73">
                  <File Id="SignalLstmOnnx" Source="../models/stock_signal_lstm_v1_seed42.onnx" KeyPath="yes" />
                </Component>
                <!-- PatchTST subseries transformer, int8. 53 KB, and the only
                     engine here whose graph executes: its declared [1, 64] input
                     and [1, 16] output match its quantized weights. -->
                <Component Id="PatchTstModelFiles" Guid="2D9A6C41-8B7E-4F53-9A16-3C5E7B0D4E82">
                  <File Id="PatchTstOnnx" Source="../models/patchtst_tiny_int8.onnx" KeyPath="yes" />
                </Component>
              </Directory>
              <!-- predictor.py backs the embedded Python cone. It is 1 KB and
                   ships; the interpreter itself is a packaging decision (see
                   the python_runtime note in README). Without an interpreter the
                   /api/ai/py_forecast route reports 503 with that reason rather
                   than inventing a forecast. -->
              <Directory Id="ScriptsFolder" Name="scripts">
                <Component Id="PredictorScript" Guid="5E0B7A29-3C48-4D6E-8B15-9F2A4E6C1D73">
                  <File Id="PredictorPy" Source="../scripts/predictor.py" KeyPath="yes" />
                </Component>
              </Directory>
              <!-- Embedded CPython 3.11 for the /api/ai/py_forecast route.
                   Installed from build\payload, which scripts/build-installer.ps1
                   produces by copying python_runtime\ and dropping the packages
                   predictor.py never imports (pandas, lightgbm) plus __pycache__.
                   The repository copy is left untouched, and the build refuses to
                   produce an MSI unless the staged interpreter imports its own
                   numpy in isolation - the bridge runs it with -E -s, so the app
                   never silently depends on a numpy the user happens to have. -->
              <Directory Id="PythonRuntimeFolder" Name="python_runtime" />
          </Directory>
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="Bharat Terminal">
        <Component Id="StartMenuShortcuts" Guid="*">
          <Shortcut Id="StartMenuApp"
                    Name="Bharat Terminal"
                    Description="Bharat Terminal — Bloomberg power. Zero cost. Made in India."
                    Target="[INSTALLFOLDER]bt-app.exe"
                    WorkingDirectory="INSTALLFOLDER" />
          <Shortcut Id="StartMenuCli"
                    Name="Bharat Terminal CLI"
                    Description="Bharat Terminal command-line visualizations."
                    Target="[INSTALLFOLDER]bt-cli.exe"
                    WorkingDirectory="INSTALLFOLDER" />
          <RegistryValue Root="HKCU"
                         Key="Software\Sourish Dey\Bharat Terminal"
                         Name="installed"
                         Value="1"
                         Type="integer"
                         KeyPath="yes" />
          <RemoveFolder Id="RemoveStartMenu" Directory="ApplicationProgramsFolder" On="uninstall" />
        </Component>
      </Directory>
    </StandardDirectory>
  </Package>
</Wix>
